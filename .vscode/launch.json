{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "PowerShell",
            "request": "launch",
            "name": "Deploy Aegis System (deploy.ps1)",
            "script": "${workspaceFolder}/scripts/deploy.ps1",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: FastAPI Backend",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.app.main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ]
        }
    ]
}