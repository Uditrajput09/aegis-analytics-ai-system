# ── Aegis Analytics AI — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is already in .gitignore.

# ── Core ML / Data ────────────────────────────────────────────────────────────
SYMBOLS=RELIANCE.NS,INFY.NS,TCS.NS
DATA_DB_PATH=data/app.db
MODEL_DIR=models
INTRADAY_INTERVAL=1m
INTRADAY_LOOKBACK_DAYS=7
DAILY_HORIZON_DAYS=1
PREDICTION_REFRESH_MINUTES=5
CONFORMAL_ALPHA=0.1

# ── Phase 0: PostgreSQL Database ──────────────────────────────────────────────
# Comment out DATABASE_URL to fall back to SQLite (dev mode).
# For PostgreSQL:   postgresql+psycopg2://user:password@localhost:5432/aegis
# For TimescaleDB:  same format — TimescaleDB is a PostgreSQL extension.
DATABASE_URL=postgresql+psycopg2://aegis_user:aegis_password@localhost:5432/aegis

# ── Phase 1: Blockchain / Web3 ────────────────────────────────────────────────
# Set BLOCKCHAIN_ENABLED=true only after deploying smart contracts.
BLOCKCHAIN_ENABLED=false

# RPC endpoint — get a free key from https://www.infura.io or https://alchemy.com
# Sepolia testnet (development):  https://sepolia.infura.io/v3/YOUR_PROJECT_ID
# Polygon mainnet (production):   https://polygon-mainnet.infura.io/v3/YOUR_PROJECT_ID
CHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Chain ID: 11155111 = Sepolia testnet | 137 = Polygon mainnet | 1 = Ethereum mainnet
CHAIN_ID=11155111

# !! CRITICAL SECURITY WARNING !!
# Use a DEDICATED signing wallet with minimal funds — NEVER your main wallet.
# Get test ETH for Sepolia from: https://sepoliafaucet.com
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed smart contract addresses (fill in after running: npx hardhat run scripts/deploy.js)
PRICE_ANCHOR_CONTRACT=0x0000000000000000000000000000000000000000
PREDICTION_AUDIT_CONTRACT=0x0000000000000000000000000000000000000000

# ── Phase 3: Crypto & DeFi Data ───────────────────────────────────────────────
# Binance API — create keys at https://www.binance.com/en/my/settings/api-management
# Use READ-ONLY permissions — no trading permissions needed.
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# CoinGecko — free tier works without a key, pro key increases rate limits
# Get key at: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=your_coingecko_api_key

# Asset classes to enable: stocks | crypto | defi (comma-separated)
ASSET_CLASSES=stocks,crypto
